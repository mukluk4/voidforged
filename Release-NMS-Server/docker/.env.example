# Copy to .env and fill in. .env is ignored by git; never commit it.
DB_ROOT_PASSWORD=change-me
DB_NAME=peq
LOGIN_DB_NAME=voidforged_login
WORLD_KEY=change-me-to-a-long-random-string

SERVER_SHORTNAME=Voidforged
SERVER_LONGNAME=Voidforged

# The address players reach this machine on
PUBLIC_ADDRESS=203.0.113.10

# New logins create an account automatically. Set false to stop new accounts.
LOGIN_AUTO_CREATE_ACCOUNTS=true

# Folder holding quests, lua_modules, maps, plugins and opcodes.conf (same layout as a Windows Build/bin/Release)
RUNTIME_DIR=/srv/voidforged/runtime

# VoidPatcher files (manifest.txt and objects/) and the port players download them on
PATCH_DIR=/srv/voidforged/patch
PATCH_PORT=8088

# Parallel compiles while building the image; 1-2 GB of memory each
BUILD_JOBS=1
DB_BUFFER_POOL=512M

# OOC <-> Discord bridge (see README.md, "Discord bridge"). Leave DISCORD_TOKEN empty to keep it off.
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
# A peq `account` row with ls_id 'eqemu' and status >= 50; world's console checks it
CONSOLE_USER=discordbridge
CONSOLE_PASSWORD=change-me
